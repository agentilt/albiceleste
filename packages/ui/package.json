{
  "name": "@albiceleste/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "albiceleste design system: tokens, typography, tables, chips, event rows and SVG charts. No framework dependencies beyond React.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css"
  },
  "files": ["dist", "src/tokens.css", "src/base.css"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
